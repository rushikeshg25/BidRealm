#Postgres URI
DATABASE_URL="postgresql://rushikesh:password@localhost:5432/Bid"

# Port the bid server listens on. Was hardcoded to 8080 in source.
PORT=8080

# Verifies the websocket tickets minted by the Next app. Must be byte-identical
# to apps/client's copy, and at least 32 characters.
# Generate one with:  openssl rand -base64 48
WS_TICKET_SECRET=
