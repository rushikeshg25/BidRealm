# Postgres (same database as the Next app)
DATABASE_URL="postgresql://bidrealm:bidrealm_local@127.0.0.1:54329/bidrealm"

# Must match AUTH_SECRET in apps/client -- the Next app signs the WebSocket
# tickets this server verifies. At least 16 characters.
AUTH_SECRET=

PORT=8080

# Redis, for queueing notification emails. Optional: if unset, bidding still
# works and notifications are skipped.
# REDIS_HOST=127.0.0.1
REDIS_PORT=63799
REDIS_PASSWORD=
