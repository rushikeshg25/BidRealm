# Postgres
DATABASE_URL="postgresql://bidrealm:bidrealm_local@127.0.0.1:54329/bidrealm"

# WebSocket ticket signing. Must match AUTH_SECRET in apps/server: this app signs
# the WebSocket tickets that server verifies. At least 16 characters.
AUTH_SECRET=

# UploadThing v7 uses a single token; the v6 SECRET/APP_ID pair is gone.
UPLOADTHING_TOKEN=

# Where the browser connects for live bidding. The NEXT_PUBLIC_ prefix is
# required -- without it Next never inlines the value and the client silently
# falls back to localhost.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"
