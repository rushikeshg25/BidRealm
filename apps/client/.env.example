#Postgres URI
DATABASE_URL="postgresql://rushikesh:password@localhost:5432/Bid"

# Uploadthing. v7 uses a single token; UPLOADTHING_SECRET and UPLOADTHING_APP_ID
# are no longer read by anything. Neither was AUTH_SECRET -- Lucia v3 does not
# use one.
UPLOADTHING_TOKEN=

# The bid server's websocket URL. This MUST carry the NEXT_PUBLIC_ prefix --
# Next only inlines variables with that prefix into the browser bundle, and the
# unprefixed WS_URL it replaces was always undefined client-side, so the app
# silently fell back to ws://localhost:8080 in every deployment.
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# Signs the short-lived tickets that authorise a websocket connection. Must be
# byte-identical to the bid server's copy, and at least 32 characters.
# Generate one with:  openssl rand -base64 48
WS_TICKET_SECRET=
