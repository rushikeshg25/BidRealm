#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# yarn.lock is the only lock file this repo uses.
#
# --diff-filter=d excludes deletions: the previous version matched any staged
# path, so once a stray lock file was committed the hook made it impossible to
# remove. It also declared a bash array under a /bin/sh shebang, which breaks
# wherever sh is not bash.
staged=$(git diff --cached --name-only --diff-filter=d)

for file in package-lock.json pnpm-lock.yaml bun.lockb; do
    if echo "$staged" | grep -qxF "$file"; then
        echo "Error: '$file' cannot be committed. This repo uses yarn; please remove it."
        exit 1
    fi
done
