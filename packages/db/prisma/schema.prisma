generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id
  sessions       Session[]
  authSessions   AuthSession[]
  accounts       AuthAccount[]
  emailVerified  Boolean       @default(false)
  image          String?
  userName       String        @unique
  email          String        @unique
  hashedPassword String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auctions       Auction[]
  bids           Bid[]
}

model Auction {
  id            String        @id @default(cuid())
  title         String
  description   String
  startingPrice Int
  currentPrice  Int
  startDate     DateTime
  endDate       DateTime
  status        AuctionStatus
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  bids          Bid[]
  image         String
  category      Category

  // The lifecycle scheduler sweeps on (status, startDate) and (status, endDate);
  // the listings page sorts by createdAt and filters by category.
  @@index([status, endDate])
  @@index([status, startDate])
  @@index([category])
  @@index([createdAt])
}

model Bid {
  id        String   @id @default(cuid())
  amount    Int
  createdAt DateTime @default(now())
  userId    String
  auctionId String

  user    User    @relation(fields: [userId], references: [id])
  auction Auction @relation(fields: [auctionId], references: [id])

  // Ledger reads are "newest bids for this auction"; My Bids reads by user.
  @@index([auctionId, createdAt])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

enum AuctionStatus {
  INACTIVE
  ACTIVE
  ENDED
  CANCELLED
}

enum Category {
  ART
  COLLECTABLES
  ELECTRONICS
  VEHICLES
  WATCHES
  FASHION
  SHOES
  MISCELLANEOUS
}

// Separate sessions allow the application switch to be reverted without
// changing Lucia's existing Session table.
model AuthSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
