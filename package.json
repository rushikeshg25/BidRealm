{
  "name": "Bid",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:env": "node scripts/setup-env.mjs",
    "dev:core": "turbo dev --filter=client --filter=server",
    "typecheck": "turbo typecheck",
    "test:auth": "node scripts/test-auth.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "effect": "3.22.4"
  }
}
